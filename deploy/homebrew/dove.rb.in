# Homebrew formula for Dove, generated by deploy/homebrew/render.sh from a release's SHA256SUMS. Do not edit by hand:
# the release workflow rewrites this file in dominik-lenhart/homebrew-tap for every stable release.
class Dove < Formula
  desc "Self-hosted MCP server that lets AI agents read and draft your email"
  homepage "https://github.com/dominik-lenhart/dove"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/dominik-lenhart/dove/releases/download/v@VERSION@/dove-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/dominik-lenhart/dove/releases/download/v@VERSION@/dove-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/dominik-lenhart/dove/releases/download/v@VERSION@/dove-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/dominik-lenhart/dove/releases/download/v@VERSION@/dove-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "dove"
  end

  def caveats
    <<~EOS
      Dove is a server. Configure and start it with the guide at
        https://github.com/dominik-lenhart/dove/blob/main/docs/deployment.md
      The formula installs only the binary; it does not register a background service.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/dove --version")
  end
end
